# Build outputs
*.obj
*.exe
*.pdb
*.ilk
*.res
*.exp
*.lib
*.dll

# The vendored compressing linker is a build tool, not a build output.
!tools/crinkler.exe

# Build directories
build/*
# ... except the packed size build: the shipped, Crinkler-compressed exe.
!build/snip.exe
out/
bin/

# Visual Studio
.vs/
*.suo
*.user
*.VC.db

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Windows
Thumbs.db
desktop.ini

# Editors
.vscode/
.idea/

# Wayfinder workspace (local tracker — not committed)
.scratch/

# Throwaway prototypes (findings are the deliverable, not the code)
prototypes/
